# Copy to .env and fill in. .env is gitignored.

# GitHub PAT — exercises 04, 06, 10. Read-only `public_repo` scope is enough.
SOURCES__GITHUB__ACCESS_TOKEN=

# Postgres source — exercises 13+. Defaults match docker-compose.yml.
SOURCES__POSTGRES__CREDENTIALS__HOST=localhost
SOURCES__POSTGRES__CREDENTIALS__PORT=5544
SOURCES__POSTGRES__CREDENTIALS__USERNAME=playground
SOURCES__POSTGRES__CREDENTIALS__PASSWORD=playground
SOURCES__POSTGRES__CREDENTIALS__DATABASE=playground

# Switch this to flip dataset_name between dev / prod-shaped runs (exercise 09)
DLT_ENV=dev
