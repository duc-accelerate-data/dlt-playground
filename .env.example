# Copy to .env and fill in. .env is gitignored.

# GitHub PAT — exercises 06, 10, 11. Read-only `public_repo` scope is enough.
SOURCES__GITHUB__ACCESS_TOKEN=

# Multi-tenant GitHub tokens — exercise 16.
SOURCES__GITHUB_A__ACCESS_TOKEN=
SOURCES__GITHUB_B__ACCESS_TOKEN=

# Switch this to flip dataset_name between dev / prod-shaped runs (exercise 09).
DLT_ENV=dev
